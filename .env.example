# Copy to .env and fill in. NEVER commit real keys.
# Friday runs in OFFLINE/SIM mode automatically when no LLM key is configured.

# --- LLM (primary: DeepSeek V4 Flash — the economic axis of FRIDAY-Δ) ---
# Default for ALL model usage: chat, memory extraction, task planning, repair.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# Cache-prefix sticky prompt: keep the top of the prompt byte-identical every turn
FRIDAY_CACHED_PREFIX_TOKENS=4800

# --- Web search (VM): Tavily is the default; Brave/Exa also supported ---
TAVILY_API_KEY=
# SEARCH_PROVIDER=tavily|brave|exa|sim
SEARCH_PROVIDER=tavily
# SEARCH_SIM_FIXTURE=configs/search_fixtures.yaml   # sim mode fixture file

# --- Voice ---
# STT is client-side (Web Speech API / whisper-tiny WASM). Server TTS optional.
GROQ_API_KEY=
TTS_PROVIDER=edge            # edge | none (client speechSynthesis fallback)
EDGE_TTS_VOICE=en-IN-NeerjaNeural

# --- Runtime ---
FRIDAY_DATA_DIR=./data
FRIDAY_GENOME_DIR=./genome
FRIDAY_EMBED_BACKEND=hash     # fastembed | hash  (fastembed auto-selected on VM)
FRIDAY_RERANK_BACKEND=heuristic # cross_encoder | heuristic
FRIDAY_HOST=0.0.0.0
FRIDAY_PORT=8000
FRIDAY_ACCESS_TOKEN=          # optional Bearer token for admin endpoints
FRIDAY_DAILY_BUDGET_USD=6.0
FRIDAY_ASK_BUDGET_DAY=2
